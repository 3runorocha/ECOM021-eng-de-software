# URLs dos microsserviços (backend).
# Copie para .env na máquina onde for rodar, se precisar mudar algo.
# Sem estas variáveis, cada serviço cai no default localhost — que é o
# suficiente para rodar tudo numa máquina só.
#
# Em Docker, os hosts passam a ser os nomes dos serviços na rede do compose:
#   IMOVEIS_URL=http://imoveis:8001

IMOVEIS_URL=http://localhost:8001
USUARIOS_URL=http://localhost:8002
CONTRATOS_URL=http://localhost:8003
NOTIFICACOES_URL=http://localhost:8004
RECOMENDACAO_URL=http://localhost:8005

# Caminho do banco SQLite de cada servico (relativo a pasta do servico).
# Util para apontar testes a um banco temporario e para volume em Docker.
IMOVEIS_DB=imoveis.db
USUARIOS_DB=usuarios.db
CONTRATOS_DB=contratos.db
NOTIFICACOES_DB=notificacoes.db
RECOMENDACAO_DB=recomendacao.db
